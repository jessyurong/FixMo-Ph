# ─── Supabase live tracking ──────────────────────────────────────────────────
# Project URL and public anon key. The anon key is safe to expose because
# supabase/tracking.sql enables RLS. Never put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Dedicated Supabase Auth user used by the POS to write mirror rows.
# Create it in Supabase Dashboard -> Authentication -> Users.
# WARNING: Vite embeds VITE_* values in the browser bundle. Use a dedicated
# account for this POS only; do not reuse an account with other privileges.
VITE_SUPABASE_SHOP_EMAIL=
VITE_SUPABASE_SHOP_PASSWORD=

# Public origin used in receipt QR codes: {VITE_PUBLIC_URL}/track/{token}.
# Include an app sub-path if the POS is hosted under one.
# Leave blank to use the current browser origin (handy for local testing).
VITE_PUBLIC_URL=

# ─── Customer email notifications (server only) ──────────────────────────────
# These are read by the /api/notify Vercel Function (and the Vite dev adapter).
# NEVER prefix these with VITE_. Vite embeds VITE_* values in the browser bundle.
# Create a Resend API key at https://resend.com/api-keys and verify your domain.
RESEND_API_KEY=
# e.g. CYNEX Technology <updates@yourdomain.com>
RESEND_FROM_EMAIL=
# Optional reply-to address for customer replies.
RESEND_REPLY_TO=

# Optional shared secret between the POS and /api/notify. Set the same value in
# both variables. This is an abuse barrier only: VITE_* values are visible in
# the browser, so do not reuse a sensitive secret.
NOTIFY_API_SECRET=
VITE_NOTIFY_API_SECRET=

# Optional path override for the notification API. Defaults to /api/notify.
VITE_NOTIFY_ENDPOINT=
