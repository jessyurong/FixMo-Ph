# FixMo PH Supabase sync (optional)
# Tracking mirror: see SUPABASE_TRACKING.md and supabase/tracking.sql
# Full database sync: see supabase/full_sync.sql
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_SHOP_EMAIL=
VITE_SUPABASE_SHOP_PASSWORD=
# Shared shop identifier used to scope cloud rows (must match RLS expectations).
VITE_SUPABASE_SHOP_ID=fixmo-ph
# Optional public origin used in printed QR codes.
VITE_PUBLIC_URL=
# Optional shop details shown to customers on the public tracking page.
# Set these in your hosting environment so every customer sees the same info.
VITE_PUBLIC_SHOP_CONTACT=
VITE_PUBLIC_SHOP_ADDRESS=
